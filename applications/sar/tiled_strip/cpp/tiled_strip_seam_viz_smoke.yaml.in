cphd:
  path: @SAR_FIXTURE@
lattice:
  tiles: 2
  max_side: 32
cphd_reader:
  coordinate_frame: ecef
  pulse_range: [0, 4]
  pulses_per_tick: 1
aperture_manager:
  max_aperture_pulses: 0
  emit_interval_pulses: 2
  emit_mode: reset
range_compression:
  propagation_speed: 299792458.0
backprojection:
  coordinate_frame: ecef
visualize: true
headless: true
visualize_size: 32
