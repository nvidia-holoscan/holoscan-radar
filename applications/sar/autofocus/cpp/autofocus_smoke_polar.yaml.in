#
# Figure 2 smoke on a range-bearing (polar) aux lattice -- the variant the
# real-collect config uses. Identical to autofocus_smoke.yaml otherwise.

cphd:
  path: @SAR_FIXTURE@
  sidecar: ""
enu_origin_ecef: [6378000.0, 0.0, 0.0]
sample_geometry:
  origin: [-2.0, 2.0, 0.0]
  axis_v: [0.0, -1.0, 0.0]
  axis_u: [1.0, 0.0, 0.0]
  spacing: [1.0, 1.0]
  counts: [5, 5]
cphd_reader:
  coordinate_frame: ecef
  pulses_per_tick: 3

# The whole aperture is retained and replayed once, which is what
# makes a corrected second pass possible at all.
aperture_manager:
  max_aperture_pulses: 5
  emit_interval_pulses: 0
  emit_mode: reform

range_compression:
  propagation_speed: 299792458.0

backprojection:
  coordinate_frame: enu

# Along-track is axis_u of the derived aux lattice. min_scatterers is
# 1 because a defocused aux can collapse to a single range row.
autofocus:
  azimuth_axis: u
  min_scatterers: 1

phase_correction:
  sense: subtract

# Rows of constant slant range, columns uniform in bearing, anchored on the
# product lattice centre. num_v is kept explicit so the fixture stays small;
# the real config auto-sizes it from the product's slant-range span.
aux_lattice:
  mode: polar
  num_v: 32

visualize: false
