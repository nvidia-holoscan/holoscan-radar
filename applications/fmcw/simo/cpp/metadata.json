{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "simo",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "language": [
      "C++"
    ],
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Detect range-Doppler cells before sparse receive beamforming"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Radar",
      "Signal Processing",
      "GPU",
      "FMCW",
      "SIMO",
      "Angle"
    ],
    "ranking": 3,
    "requirements": {},
    "default_mode": "default",
    "modes": {
      "default": {
        "description": "Detect range-Doppler cells before sparse receive beamforming",
        "run": {
          "command": "<holohub_app_bin>/simo",
          "workdir": "holohub_app_bin"
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DPKG_holoscan_radar=OFF",
            "-DHOLOSCAN_RADAR_APPLICATION=simo"
          ]
        }
      },
      "smoke": {
        "description": "Run the short headless smoke preset",
        "run": {
          "command": "<holohub_app_bin>/simo simo_smoke.yaml",
          "workdir": "holohub_app_bin"
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DPKG_holoscan_radar=OFF",
            "-DHOLOSCAN_RADAR_APPLICATION=simo"
          ]
        }
      }
    }
  }
}
