{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "adaptive_aoa",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "language": [
      "Python"
    ],
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Selective super-resolution AoA demonstration"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Radar",
      "Signal Processing",
      "GPU",
      "FMCW",
      "MIMO",
      "TDM",
      "AoA"
    ],
    "ranking": 3,
    "requirements": {},
    "default_mode": "default",
    "modes": {
      "default": {
        "description": "Run the Python adaptive_aoa Graph workflow",
        "run": {
          "command": "python3.12 -m holoscan_radar.applications.cli adaptive_aoa",
          "workdir": "<holohub_app_source>/../config",
          "env": {
            "PYTHONPATH": "/opt/nvidia/holoscan/lib/python3.12/site-packages:<holohub_bin>/python/lib:<PYTHONPATH>",
            "HOLOSCAN_LIB_PATH": "/opt/nvidia/holoscan/lib"
          }
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DHOLOSCAN_RADAR_BUILD_PYTHON=ON",
            "-Dholoscan_DIR=/opt/nvidia/holoscan/lib/cmake/holoscan"
          ]
        }
      }
    }
  }
}
