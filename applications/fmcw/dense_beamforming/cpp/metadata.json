{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "dense_beamforming",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "language": [
      "C++"
    ],
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Beamform the full SIMO range-Doppler cube before detection"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Radar",
      "Signal Processing",
      "GPU",
      "FMCW",
      "SIMO",
      "Angle",
      "Beamforming"
    ],
    "ranking": 3,
    "requirements": {},
    "default_mode": "default",
    "modes": {
      "default": {
        "description": "Beamform the full SIMO range-Doppler cube before detection",
        "run": {
          "command": "<holohub_app_bin>/dense_beamforming",
          "workdir": "holohub_app_bin"
        }
      },
      "smoke": {
        "description": "Run the short headless smoke preset",
        "run": {
          "command": "<holohub_app_bin>/dense_beamforming dense_beamforming_smoke.yaml",
          "workdir": "holohub_app_bin"
        }
      }
    }
  }
}
