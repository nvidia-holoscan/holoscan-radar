{
    "$schema": "urn:holohub:application:v1",
    "application": {
        "name": "mimo",
        "authors": [
            {
                "name": "Holoscan Team",
                "affiliation": "NVIDIA"
            }
        ],
        "language": ["C++"],
        "version": "0.1.0",
        "changelog": {
            "0.1.0": "Add consolidated HSDK 5 MIMO TDM and DDM workflows"
        },
        "holoscan_sdk": {
            "minimum_required_version": "5.0.0",
            "tested_versions": ["5.0.0"]
        },
        "platforms": ["x86_64", "aarch64"],
        "tags": ["Radar", "Signal Processing", "GPU", "FMCW", "MIMO", "Angle"],
        "ranking": 3,
        "requirements": {},
        "default_mode": "tdm",
        "modes": {
            "tdm": {
                "description": "Sparse detect-before-compensate TDM with angle estimation",
                "run": {
                    "command": "<holohub_app_bin>/fmcw_mimo_tdm",
                    "workdir": "holohub_app_bin"
                }
            },
            "ddm": {
                "description": "Dense DDM front end with sparse angle estimation",
                "run": {
                    "command": "<holohub_app_bin>/fmcw_mimo_ddm",
                    "workdir": "holohub_app_bin"
                }
            }
        }
    }
}
