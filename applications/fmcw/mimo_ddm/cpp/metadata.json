{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "mimo_ddm",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "language": [
      "C++"
    ],
    "version": "1.0.0",
    "changelog": {
      "0.1.0": "Dense-demultiplex MIMO DDM processing with sparse angle estimation"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Radar",
      "Signal Processing",
      "GPU",
      "FMCW",
      "MIMO",
      "DDM",
      "Angle"
    ],
    "ranking": 3,
    "requirements": {},
    "default_mode": "default",
    "modes": {
      "default": {
        "description": "Linear MIMO DDM with sparse angle estimation",
        "run": {
          "command": "<holohub_app_bin>/mimo_ddm",
          "workdir": "holohub_app_bin"
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DPKG_holoscan_radar=OFF"
          ]
        }
      },
      "smoke": {
        "description": "Run the short headless smoke preset",
        "run": {
          "command": "<holohub_app_bin>/mimo_ddm mimo_ddm_linear_smoke.yaml",
          "workdir": "holohub_app_bin"
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DPKG_holoscan_radar=OFF"
          ]
        }
      },
      "nonlinear_ddm": {
        "description": "Nonlinear MIMO DDM with sparse angle estimation",
        "run": {
          "command": "<holohub_app_bin>/mimo_ddm mimo_ddm_nonlinear.yaml",
          "workdir": "holohub_app_bin"
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DPKG_holoscan_radar=OFF"
          ]
        }
      },
      "nonlinear_ddm_smoke": {
        "description": "Run the nonlinear DDM headless smoke preset",
        "run": {
          "command": "<holohub_app_bin>/mimo_ddm mimo_ddm_nonlinear_smoke.yaml",
          "workdir": "holohub_app_bin"
        },
        "build": {
          "cmake_options": [
            "-DBUILD_ALL=OFF",
            "-DHOLOSCAN_RADAR_BUILD_TESTING=OFF",
            "-DPKG_holoscan_radar=OFF"
          ]
        }
      }
    }
  }
}
