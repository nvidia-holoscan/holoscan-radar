@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(holoscan 5.0 CONFIG COMPONENTS core params_io)
find_dependency(CUDAToolkit)
find_dependency(yaml-cpp CONFIG)
# Keep MatX aligned with the selected SDK without changing caller search paths.
set(_radar_saved_prefix_path "${CMAKE_PREFIX_PATH}")
get_filename_component(_radar_sdk_prefix "${holoscan_DIR}/../../.." ABSOLUTE)
list(PREPEND CMAKE_PREFIX_PATH "${_radar_sdk_prefix}")
find_package(matx QUIET)
set(CMAKE_PREFIX_PATH "${_radar_saved_prefix_path}")
unset(_radar_saved_prefix_path)
unset(_radar_sdk_prefix)
find_dependency(matx)
if(@HOLOSCAN_RADAR_CONFIG_HAS_CPHD@)
    find_dependency(Threads)
    find_dependency(tinyxml2 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/holoscan_radar_targets.cmake")
check_required_components(holoscan-radar)
