{
  "$schema": "urn:holohub:module:v2",
  "module": {
    "name": "holoscan-radar",
    "version": "0.2.0",
    "description": "Accelerated radar signal processing operators for the Holoscan ecosystem",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "license": "Apache-2.0",
    "language": [
      "C++",
      "Python"
    ],
    "namespace": {
      "cpp": "holoscan::radar",
      "python": "holoscan.radar"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Radar",
      "Signal Processing",
      "GPU",
      "Accelerated Computing",
      "FMCW",
      "Pulse-Doppler",
      "Synthetic Aperture Radar"
    ],
    "source_repository": "https://github.com/nvidia-holoscan/holoscan-radar",
    "operator_names": [
      "beamscan_estimator_op",
      "cfar_detector_op",
      "cluster_dbscan_op",
      "clutter_filter_op",
      "ddm_dense_demultiplex_op",
      "ddm_power_fold_op",
      "ddm_sparse_demultiplex_op",
      "detection_reduction_op",
      "doppler_notch_op",
      "esprit_estimator_op",
      "feature_assembly_op",
      "fmcw_doppler_processor_op",
      "fmcw_range_doppler_processor_op",
      "fmcw_range_processor_op",
      "mimo_deinterleave_op",
      "music_estimator_op",
      "mvdr_estimator_op",
      "phase_shift_beamformer_op",
      "root_music_estimator_op",
      "snapshot_gather_op",
      "subarray_selection_op",
      "tdm_dense_compensation_op",
      "tdm_sparse_compensation_op",
      "virtual_array_assembly_op"
    ],
    "dockerfile": "Dockerfile"
  }
}
