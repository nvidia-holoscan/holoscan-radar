#
# Convenience wrapper for the Holoscan CLI. Project settings live in
# pyproject.toml and metadata.json, so running `holoscan` from an environment
# with requirements-cli.txt installed is equivalent. This script only picks the
# interpreter, in order:
#   1. HOLOSCAN_CLI_PYTHON_BIN, which must already have the CLI;
#   2. the active venv, or python3 (e.g. the development image), if it has the CLI;
#   3. a managed venv (HOLOSCAN_CLI_VENV, default
#      ~/.local/share/holoscan-radar/cli-venv), installed from
#      requirements-cli.txt. Holoscan CLI 5 requires Python 3.11+.
#
# Usage:
#   ./holohub run-container
#   ./holohub build fmcw_siso
#   ./holohub test

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REQUIREMENTS="${SCRIPT_DIR}/requirements-cli.txt"
export HOLOSCAN_CLI_ROOT="${HOLOSCAN_CLI_ROOT:-${SCRIPT_DIR}}"
export HOLOSCAN_CLI_CMD_NAME="${HOLOSCAN_CLI_CMD_NAME:-${BASH_SOURCE[0]}}"

_fail() {
    echo "[holoscan-radar] $*" >&2
    exit 1
}
# holoscan_cli.project_context ships with CLI 5 only.
_has_cli() {
    "$1" -c 'import holoscan_cli.project_context' >/dev/null 2>&1
}

if [[ -n "${HOLOSCAN_CLI_PYTHON_BIN:-}" ]]; then
    PYTHON_BIN="${HOLOSCAN_CLI_PYTHON_BIN}"
    _has_cli "${PYTHON_BIN}" || _fail "${PYTHON_BIN} lacks Holoscan CLI 5;" \
        "run '${PYTHON_BIN} -m pip install -r ${REQUIREMENTS}' (Python 3.11+)."
elif [[ -n "${VIRTUAL_ENV:-}" ]] && _has_cli "${VIRTUAL_ENV}/bin/python"; then
    PYTHON_BIN="${VIRTUAL_ENV}/bin/python"
elif _has_cli python3; then
    PYTHON_BIN=python3
else
    # Kept apart from HoloHub's holoscan-cli/venv, which pins a different CLI.
    VENV="${HOLOSCAN_CLI_VENV:-${XDG_DATA_HOME:-${HOME:?set HOME or HOLOSCAN_CLI_VENV}/.local/share}/holoscan-radar/cli-venv}"
    if ! "${VENV}/bin/python" -m pip --version >/dev/null 2>&1; then
        BASE_PYTHON=""
        for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
            if "${candidate}" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
                BASE_PYTHON="${candidate}"
                break
            fi
        done
        [[ -n "${BASE_PYTHON}" ]] ||
            _fail "Holoscan CLI 5 needs Python 3.11+; install it or set HOLOSCAN_CLI_PYTHON_BIN."
        "${BASE_PYTHON}" -m venv "${VENV}" ||
            _fail "Could not create ${VENV}; install ${BASE_PYTHON}-venv."
    fi
    # Install on first use and whenever the pin changes; keep stdout for the CLI.
    if ! cmp -s "${REQUIREMENTS}" "${VENV}/requirements-cli.txt"; then
        echo "[holoscan-radar] Installing the pinned Holoscan CLI into ${VENV}" >&2
        "${VENV}/bin/python" -m pip install --quiet --disable-pip-version-check \
            -r "${REQUIREMENTS}" >&2
        cp "${REQUIREMENTS}" "${VENV}/requirements-cli.txt"
    fi
    PYTHON_BIN="${VENV}/bin/python"
fi

# CLI subprocesses (lint hooks, packaging) reuse this interpreter, also after the
# CLI changes directory, so export an absolute path and put it first on PATH.
PYTHON_PATH="$(type -P "${PYTHON_BIN}")" || _fail "Python interpreter not found: ${PYTHON_BIN}"
PYTHON_BIN="$(cd "$(dirname "${PYTHON_PATH}")" && pwd)/$(basename "${PYTHON_PATH}")"
export HOLOSCAN_CLI_PYTHON_BIN="${PYTHON_BIN}"
export PATH="${PYTHON_BIN%/*}:${PATH}"
exec "${PYTHON_BIN}" -m holoscan_cli "$@"
