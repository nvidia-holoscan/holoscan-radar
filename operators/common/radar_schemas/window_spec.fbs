include "tensor.fbs";

namespace holoscan.radar.wire;

enum WindowType : ubyte {
  None = 0,
  Hann,
  Hamming,
  Blackman,
  BlackmanHarris,
  Kaiser,
  Chebyshev,
  Taylor,
  FlatTop,
  Tukey,
  Custom,
}

table WindowSpec {
  type: WindowType = None (id: 0);
  sidelobe_attenuation_db: double = 30.0 (id: 1);
  // EA descriptor traits do not compile nullable scalars; preserve optional
  // semantics losslessly with an explicit presence bit.
  kaiser_beta: double (id: 2);
  has_kaiser_beta: bool = false (id: 3);
  taylor_nbar: int = 4 (id: 4);
  tukey_alpha: double = 0.5 (id: 5);
  coefficients: holoscan.schema.Tensor (id: 6);
  coherent_gain_normalization: bool = true (id: 7);
}

root_type WindowSpec;
file_identifier "RWSP";
