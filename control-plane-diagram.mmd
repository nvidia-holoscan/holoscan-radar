flowchart LR
    subgraph TX["FMCWTransmitSourceOp — independent source"]
        SELECT["select next CPI profile"] --> DRIVER["TX backend"]
        DRIVER --> APPLIED["applied profile + token + t_tx"]
        APPLIED --> WAVEFORM["publish waveform @ t_tx"]
    end
    COORD["TransmitFrameCoordinator<br/>bounded token to t_tx ledger"]
