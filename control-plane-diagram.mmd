    end
    APPLIED --> COORD
    WAVEFORM -->|"mark ready after emit"| COORD
    COORD --> CLAIM
    DRIVER -. "transmission / simulation" .-> RXDRIVER
    ADC --> DSP["existing MIMO TDM DSP"]
    WAVEFORM -->|"Exact live waveform"| DSP

    style TX fill:#2962FF, color:#FFFFFF
